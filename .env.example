# ===== 数据库 =====
POSTGRES_USER=foodlog
POSTGRES_PASSWORD=foodlog123
POSTGRES_DB=foodlog

# ===== 后端 =====
SERVER_PORT=8080
# 数据库连接串（本地开发用 localhost，Docker 内用 db）
DATABASE_URL=postgres://foodlog:foodlog123@localhost:5432/foodlog?sslmode=disable
# JWT 签名密钥（生产环境务必替换）
JWT_SECRET=foodlog-secret-change-me
# 上传文件存储目录
UPLOAD_DIR=./server/uploads
# 允许跨域的前端来源（逗号分隔）
CLIENT_ORIGIN=http://localhost:5173

# ===== 前端 =====
CLIENT_PORT=80
VITE_API_BASE=/api
