# ===== 数据库 =====
POSTGRES_USER=foodlog
POSTGRES_PASSWORD=foodlog123
POSTGRES_DB=foodlog

# ===== 后端 =====
SERVER_PORT=8080
# 数据库连接串（本地开发用 localhost，Docker 内用 db）
DATABASE_URL=postgres://foodlog:foodlog123@localhost:5432/foodlog?sslmode=disable
# JWT 签名密钥（生产环境务必替换）
JWT_SECRET=foodlog-secret-change-me
# 上传文件存储目录
UPLOAD_DIR=./server/uploads
# 允许跨域的前端来源（逗号分隔）
CLIENT_ORIGIN=http://localhost:5173

# ===== AI（自动标签兜底 / 图片识别）=====
# 提供者：openai | ollama（留空且无 API_KEY 则禁用 AI）
AI_PROVIDER=
# OpenAI 兼容接口地址（如 https://api.openai.com/v1 或 Ollama 的 OpenAI 兼容端点）
AI_BASE_URL=
# API Key（Ollama 无需填写）
AI_API_KEY=
# 模型名（OpenAI 兼容如 gpt-4o-mini；Ollama 如 llava / qwen2.5-vl）
AI_MODEL=
# 请求超时（秒，默认 3）
AI_TIMEOUT=3

# ===== 前端 =====
CLIENT_PORT=80
VITE_API_BASE=/api
