# =============================================
# 运行模式（决定是否加载演示数据）
#   development  加载演示数据（admin/admin、示例菜谱），不引导生产管理员
#   production   跳过演示数据，按 ADMIN_USERNAME / ADMIN_PASSWORD 引导管理员（默认）
# =============================================
APP_ENV=production

# ===== 端口 =====
# 生产：应用单镜像端口（同一进程提供前端静态资源 + API + 图片）
APP_PORT=8080
# 开发：Vite dev server 端口
CLIENT_PORT=5173
# 后端监听端口（容器内固定 8080）
SERVER_PORT=8080
# 数据库对外端口（开发用）
POSTGRES_PORT=5432

# ===== 数据库 =====
POSTGRES_USER=foodlog
POSTGRES_PASSWORD=foodlog123
POSTGRES_DB=foodlog
# 本机工具（psql 等）使用的连接串；容器内由 compose 覆盖为 db:5432
DATABASE_URL=postgres://foodlog:foodlog123@localhost:5432/foodlog?sslmode=disable

# ===== 数据目录（凭证 / 上传中转 / 图片）=====
# 容器内固定为 /app/data，宿主机 bind mount 到 ./data
DATA_DIR=./data

# ===== 前端静态资源目录（不使用 go:embed，运行时读盘）=====
# 容器内固定为 /app/dist（由镜像构建阶段拷贝前端产物）
# 本地跑二进制时默认 ./dist（scripts/build.sh 的产出目录）
STATIC_DIR=./dist

# ===== 后端 =====
# JWT 签名密钥（生产环境务必替换）
JWT_SECRET=foodlog-secret-change-me
# 允许跨域的前端来源（逗号分隔）
CLIENT_ORIGIN=http://localhost:5173

# ===== 管理员引导（仅生产模式生效）=====
ADMIN_USERNAME=admin
# 留空则在首次启动时自动生成随机密码（UUIDv7）并写入
# data/credentials/admin-password.txt，之后启动复用该文件
ADMIN_PASSWORD=

# ===== AI（自动标签兜底 / 图片识别）=====
# 提供者：openai | ollama（留空且无 API_KEY 则禁用 AI）
AI_PROVIDER=
# OpenAI 兼容接口地址（如 https://api.openai.com/v1 或 Ollama 的 OpenAI 兼容端点）
AI_BASE_URL=
# API Key（Ollama 无需填写）
AI_API_KEY=
# 模型名（OpenAI 兼容如 gpt-4o-mini；Ollama 如 llava / qwen2.5-vl）
AI_MODEL=
# 请求超时（秒，默认 3）
AI_TIMEOUT=3

# ===== 前端 =====
VITE_API_BASE=/api

# ===== 可选：生产镜像地址（默认本地构建 food-log:local）=====
# APP_IMAGE=ghcr.io/blue-cloud-net/food-log:latest
