# ===== 环境变量 =====
.env
.env.local
.env.*.local

# ===== 前端 =====
.pnpm-store/
node_modules/
dist/
client/dist/
*.local
.vite/

# ===== Go 后端 =====
server/bin/
server/.air/
# go:embed 目录：dist/ 规则会整体排除该目录，这里显式解除以保留占位文件
!server/internal/web/dist/
server/internal/web/dist/*
!server/internal/web/dist/.gitkeep
*.exe
*.test
*.out

# ===== 运行时数据（凭证 / 上传中转 / 图片）=====
data/*
!data/.gitkeep

# ===== 日志与临时文件 =====
*.log
*.tmp
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
